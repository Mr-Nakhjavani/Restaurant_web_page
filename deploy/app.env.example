# Template for /etc/bayt-al-ghaf/app.env, read by the bayt-al-ghaf systemd service and by
# deploy/deploy.sh. Keep the real file root-only (chmod 600). Values must not contain
# spaces or "$" (the file is read both by systemd and by the shell).
# Do not set NODE_ENV here: the unit sets it, and `npm ci` must still install dev tools.

# development | staging | production. "production" refuses the test clock.
APP_ENV="staging"

# Port and database. Use a dedicated database and role for each deployment.
PORT="3000"
DATABASE_URL="postgresql://<db-user>:<db-password>@localhost:5433/<db-name>?schema=public"

# Public base URL of this deployment and browser origins allowed by CORS.
APP_BASE_URL="http://<public-host>:3000"
CORS_ALLOWED_ORIGINS="http://<public-host>:3000,http://localhost:3000"

# Signs admin session cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="<random-64-hex-characters>"

RATE_LIMIT_ENABLED="true"
# "true" only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY="false"
LOG_LEVEL="info"

# Test-environment helpers (see docs/integration/handoff-checklist.md). Set both to
# "false" for a real restaurant.
SIMULATE_KITCHEN_PROGRESS="true"
ENABLE_TEST_CLOCK="true"
