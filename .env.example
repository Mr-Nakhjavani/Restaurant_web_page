# ---------------------------------------------------------------------------
# Bayt Al Ghaf — environment configuration (copy to .env and adjust).
# Never commit real secrets. All values below are development placeholders.
# ---------------------------------------------------------------------------

# Deployment tier: development | staging | production.
# "production" refuses placeholder secrets and the test clock.
APP_ENV="development"

# PostgreSQL connection (docker compose exposes the dev database on port 5433)
DATABASE_URL="postgresql://bayt:bayt_dev_password@localhost:5433/bayt_al_ghaf?schema=public"

# Public base URL of this deployment (used in links inside API responses and docs)
APP_BASE_URL="http://localhost:3000"

# Comma-separated list of browser origins allowed to call the API with CORS.
# Server-to-server clients (e.g. the external voice agent) do not need CORS.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Secret used to sign admin session cookies (min. 32 random characters).
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"

# Initial back-office accounts created by `npm run db:seed` (change after first login).
SEED_ADMIN_EMAIL="admin@baytalghaf.example"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-2026"
SEED_STAFF_EMAIL="staff@baytalghaf.example"
SEED_STAFF_PASSWORD="ChangeMe-Staff-2026"

# Optional: a development API key for the external voice agent (scope "agent").
# Leave empty in production and create keys from Admin → API keys instead.
SEED_AGENT_API_KEY="bg_dev_agent_key_for_local_testing_only"

# Rate limiting (in-memory, per process). Set to "false" only for load testing.
RATE_LIMIT_ENABLED="true"

# Trust X-Forwarded-For for client IPs (set "true" only behind a trusted reverse proxy).
TRUST_PROXY="false"

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Simulation: automatically advance confirmed orders to preparing/ready as time passes
# (useful in a test environment with no kitchen staff). Set "false" in a real deployment.
SIMULATE_KITCHEN_PROGRESS="true"

# Test clock: when "true", requests may send `X-Test-Now: <ISO datetime>` to simulate the
# current time (e.g. test Friday-only dishes on a Tuesday). NEVER enable in production.
ENABLE_TEST_CLOCK="false"
