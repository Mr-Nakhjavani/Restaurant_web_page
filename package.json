{
  "name": "bayt-al-ghaf",
  "version": "1.0.0",
  "private": true,
  "description": "Bayt Al Ghaf — fictional Emirati restaurant website, backend and voice-agent-ready API (test environment).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "kb:build": "tsx scripts/build-knowledge.ts",
    "rag:build": "tsx scripts/build-rag-corpus.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "docs:build": "npm run kb:build && npm run openapi:export",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:reset:test": "tsx scripts/reset-test-db.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "^18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
