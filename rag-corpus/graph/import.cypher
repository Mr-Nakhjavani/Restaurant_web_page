// Load the Bayt Al Ghaf knowledge graph into Neo4j 5.
// Copy nodes.csv and edges.csv into the Neo4j import directory, then run this file (for example with cypher-shell -f import.cypher).
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
LOAD CSV WITH HEADERS FROM 'file:///nodes.csv' AS row WITH row WHERE row.type = 'Allergen' MERGE (n:Entity {id: row.id}) SET n:Allergen, n.name = row.name, n.description = row.description, n.document = row.document, n.properties = row.properties;
LOAD CSV WITH HEADERS FROM 'file:///nodes.csv' AS row WITH row WHERE row.type = 'Area' MERGE (n:Entity {id: row.id}) SET n:Area, n.name = row.name, n.description = row.description, n.document = row.document, n.properties = row.properties;
