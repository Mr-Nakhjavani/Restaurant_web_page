LOAD CSV WITH HEADERS FROM 'file:///edges.csv' AS row WITH row WHERE row.type = 'ACCEPTS_PAYMENT' MATCH (a:Entity {id: row.source}), (b:Entity {id: row.target}) MERGE (a)-[r:ACCEPTS_PAYMENT]->(b) SET r.description = row.description, r.properties = row.properties;
